# Generic OpenAI-compatible LLM (OpenRouter, local LiteLLM, Ollama gateway, etc.)
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=openrouter/free

# Optional local Ollama fallback
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5-coder:14b

# Existing RunPod/ComfyUI video endpoint
RUNPOD_ENDPOINT_URL=
RUNPOD_API_KEY=

# Character asset generation (ComfyUI/RunPod API endpoint)
CHARACTER_COMFY_ENDPOINT=

# TTS / lip sync
# Default: Chatterbox Multilingual V3 for TR/DE/AR/FR/ES cross-language character identity.
TTS_ENGINE=chatterbox_api
CHATTERBOX_API_URL=http://voice-service:4123
CHATTERBOX_DEVICE=cpu
CHATTERBOX_EXAGGERATION=0.45
CHATTERBOX_CFG_WEIGHT=0.35
# Piper remains an optional lightweight fallback.
PIPER_BIN=piper
PIPER_VOICES_DIR=./assets/voices
RHUBARB_BIN=rhubarb

# Music / SFX
MUSIC_STRATEGY=library_or_generate

# Telegram control plane
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_MAX_UPLOAD_MB=45
# Optional public URL that maps to cartoon_factory/output for large video delivery
PUBLIC_OUTPUT_BASE_URL=

# Render
FFMPEG_BIN=ffmpeg
OUTPUT_DIR=./output
CARTOON_WIDTH=1920
CARTOON_HEIGHT=1080
CARTOON_FPS=24
CARTOON_FALLBACK_BG=#87CEEB
