# Generic OpenAI-compatible LLM (OpenRouter, local LiteLLM, Ollama gateway, etc.)
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=openrouter/free

# Optional local Ollama fallback
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5-coder:14b

# Existing RunPod/ComfyUI video endpoint
RUNPOD_ENDPOINT_URL=
RUNPOD_API_KEY=

# TTS / lip sync
TTS_ENGINE=piper
PIPER_BIN=piper
PIPER_VOICES_DIR=./assets/voices
RHUBARB_BIN=rhubarb

# Music / SFX
MUSIC_STRATEGY=library_or_generate

# Render
FFMPEG_BIN=ffmpeg
OUTPUT_DIR=./output
CARTOON_WIDTH=1920
CARTOON_HEIGHT=1080
CARTOON_FPS=24
CARTOON_FALLBACK_BG=#87CEEB
