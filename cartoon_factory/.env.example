# Generic OpenAI-compatible LLM (OpenRouter, local LiteLLM, Ollama gateway, etc.)
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=openrouter/free

# Optional local Ollama fallback
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5-coder:14b

# Existing RunPod/ComfyUI video endpoint
RUNPOD_ENDPOINT_URL=
RUNPOD_API_KEY=

# TTS
TTS_ENGINE=piper
PIPER_BIN=piper
PIPER_VOICES_DIR=./assets/voices

# Render
FFMPEG_BIN=ffmpeg
OUTPUT_DIR=./output
