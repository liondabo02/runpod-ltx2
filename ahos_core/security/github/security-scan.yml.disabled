# REVIEWED TEMPLATE ONLY — rename into .github/workflows after a separate activation approval.
name: AHOS security scan
on:
  workflow_dispatch:
permissions:
  contents: read
jobs:
  python-tests:
    runs-on: ubuntu-latest
    timeout-minutes: 15
    steps:
      - name: Checkout pinned action
        uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683
      - name: Setup Python pinned action
        uses: actions/setup-python@42375524e23c412d93fb67b49958b491fce71c38
        with:
          python-version: "3.12"
      - name: Install test dependency
        run: python -m pip install "pytest>=9.1,<10"
      - name: Run AHOS tests
        working-directory: ahos_core
        run: python -m pytest -q
