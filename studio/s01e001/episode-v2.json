  "scenes": [
    {
      "scene_id": "V2-S01",
      "title": "Kuyruk uyanıyor",
      "start_seconds": 0,
      "duration_seconds": 45,
      "setting": "Park, piknik örtüsünün yanı; sabah",
      "cast_ids": [
        "aden",
        "kaan",
        "esra"
      ],
      "objective": "İlk 30 saniyede merak ve gülüş; kuyruğu bağlama hedefi",
      "action": "Uçurtma yerde, kuyruk gevşek. Rüzgâr kuyruğu canlı gibi kıpırdatır; Kaan'ın yanağını gıdıklar, sonra başına düşer. Aden güler, Esra kadraj dışından seslenir.",
      "beats": [
        {
          "start_seconds": 0,
          "duration_seconds": 10,
          "action": "Rüzgâr kuyruk ucunu kaldırır, Kaan'ın yanağını gıdıklar; Kaan gözlerini kırpıştırır.",
          "focus": "kuyruk + Kaan yüzü",
          "kaan_action": "blinks",
          "event": "tail_tickle"
        },
        {
          "start_seconds": 10,
          "duration_seconds": 10,
          "action": "Kaan kuyruğu yakalamaya çalışırken yana yalpalar; Aden elini uzatıp dengede tutar. Kuyruk başına düşer.",
          "focus": "iki çocuk ayakta",
          "kaan_action": "wobbles",
          "event": "tail_on_head"
        },
        {
          "start_seconds": 20,
          "duration_seconds": 10,
          "action": "Aden kuyruğu Kaan'ın başından alır; Kaan 'Aa!' der, ikisi birlikte güler. Esra kadraj dışından seslenir.",
          "focus": "ikili plan",
          "kaan_action": "laughs",
          "event": "adult_call"
        },
        {
          "start_seconds": 30,
          "duration_seconds": 8,
          "action": "Aden çömelir, kuyruğu uçurtmaya bağlamaya başlar; Kaan mavi panele dokunur.",
          "focus": "eller + Kaan",
          "kaan_action": "touches"
        },
        {
          "start_seconds": 38,
          "duration_seconds": 7,
          "action": "Düğüm yarım kalır; rüzgâr uçurtmanın köşesini kaldırır. Aden 'Şimdi bekle' der.",
          "focus": "uçurtma + Aden",
          "kaan_action": "watches"
        }
      ],
      "dialogue": [
        {
          "speaker": "kaan",
          "text": "Aa!",
          "emotion": "şaşkın gülüş",
          "voice_duration_seconds": 1.0,
          "start_seconds": 18.0
        },
        {
          "speaker": "aden",
          "text": "Kuyruk seninle oynuyor!",
          "emotion": "gülerek",
          "voice_duration_seconds": 2.0,
          "start_seconds": 20.5
        },
        {
          "speaker": "esra",
          "text": "Kuyruğu birlikte bağlayın.",
          "emotion": "sıcak, kadraj dışı",
          "voice_duration_seconds": 2.4,
          "start_seconds": 24.0
        },
        {
          "speaker": "kaan",
          "text": "Mavi!",
          "emotion": "işaret ederek",
          "voice_duration_seconds": 1.0,
          "start_seconds": 26.5
        }
      ]
    },
    {
      "scene_id": "V2-S02",
      "title": "Düğüm ve ilk deneme",
      "start_seconds": 45,
      "duration_seconds": 45,
      "setting": "Park, piknik örtüsü yanı; sabah",
      "cast_ids": [
        "aden",
        "kaan",
        "esra"
      ],
      "objective": "Sabır: düğümü tamamla, ilk denemenin başarısız olmasını kabul et",
      "action": "Aden düğümü tamamlar; Esra ipi yerden alır. İlk kaldırma denemesinde rüzgâr yetmez, uçurtma yana devrilir. Kaan kıkırdar; Aden yeniden dener.",
      "beats": [
        {
          "start_seconds": 45,
          "duration_seconds": 9,
          "action": "Aden düğümü sıkılaştırır; Esra ipi çözer ve yere serer.",
          "focus": "eller",
          "kaan_action": "watches"
        },
        {
          "start_seconds": 54,
          "duration_seconds": 9,
          "action": "Aden ipi iki eliyle tutar, geriye yürür; Esra uçurtmayı kaldırır.",
          "focus": "geniş ikili",
          "kaan_action": "claps"
        },
        {
          "start_seconds": 63,
          "duration_seconds": 9,
          "action": "Rüzgâr kesilir; uçurtma yana devrilir, kuyruk çimene yayılır.",
          "focus": "uçurtma",
          "kaan_action": "giggles"
        },
        {
          "start_seconds": 72,
          "duration_seconds": 9,
          "action": "Kaan kıkırdayınca Aden de güler; Esra 'Bir daha' der.",
          "focus": "üçlü",
          "kaan_action": "laughs"
        },
        {
          "start_seconds": 81,
          "duration_seconds": 9,
          "action": "Aden ipi toplar, duruşunu düzeltir; ikinci deneme için hazırlanır.",
          "focus": "Aden",
          "kaan_action": "watches"
        }
      ],
      "dialogue": [
        {
          "speaker": "aden",
          "text": "Önce düğüm.",
          "emotion": "odaklanmış",
          "voice_duration_seconds": 1.4,
          "start_seconds": 48.0
        },
        {
          "speaker": "esra",
          "text": "İpi yerde tut, ben kaldırayım.",
          "emotion": "yönlendiren",
          "voice_duration_seconds": 2.4,
          "start_seconds": 57.0
        },
        {
          "speaker": "kaan",
          "text": "Ya!",
          "emotion": "kıkırdayarak",
          "voice_duration_seconds": 0.9,
          "start_seconds": 72.0
        },
        {
          "speaker": "aden",
          "text": "Bir daha deneyelim.",
          "emotion": "kararlı",
          "voice_duration_seconds": 1.8,
          "start_seconds": 78.0
        }
      ]
    },
    {
