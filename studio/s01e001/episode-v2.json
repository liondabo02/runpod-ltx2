          "emotion": "heyecanlı",
          "voice_duration_seconds": 1.0,
          "start_seconds": 114.0
        },
        {
          "speaker": "esra",
          "text": "Yavaşça, ipi bırakma.",
          "emotion": "sakin",
          "voice_duration_seconds": 2.2,
          "start_seconds": 120.0
        }
      ]
    },
