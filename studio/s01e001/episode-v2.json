          "kaan_action": "points"
        },
        {
          "start_seconds": 114,
          "duration_seconds": 8,
          "action": "Esra ipin ucunu Aden'in elinin altında tutar; ikisi birlikte dengeler.",
          "focus": "eller",
          "kaan_action": "claps"
        },
        {
          "start_seconds": 122,
          "duration_seconds": 8,
          "action": "Uçurtma tepe noktaya ulaşır; üçü de yukarı bakar.",
          "focus": "alçak açı",
          "kaan_action": "looks_up"
        }
      ],
      "dialogue": [
        {
          "speaker": "aden",
          "text": "Uçtu!",
