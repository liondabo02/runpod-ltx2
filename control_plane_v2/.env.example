# Model routing. Use secrets/environment; never commit real keys.
MINIVERSE_SUPERVISOR_MODEL=
MINIVERSE_SCOUT_MODEL=
MINIVERSE_QA_MODEL=
MINIVERSE_COST_MODEL=
MINIVERSE_OPENHANDS_MODEL=

# One provider key is enough to start. LLM_API_KEY is used by OpenHands.
OPENAI_API_KEY=
LLM_API_KEY=

# Optional OpenAI-compatible gateway, for example LiteLLM/OpenRouter proxy.
MINIVERSE_LLM_BASE_URL=
MINIVERSE_WORKSPACE_ROOT=/workspace
MINIVERSE_MAX_PARALLEL_AGENTS=4
