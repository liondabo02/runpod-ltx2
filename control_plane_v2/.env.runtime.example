# Copy to .env.runtime on the always-on host. Do not commit real secrets.

MINIVERSE_SUPERVISOR_MODEL=
MINIVERSE_SCOUT_MODEL=
MINIVERSE_QA_MODEL=
MINIVERSE_COST_MODEL=
MINIVERSE_OPENHANDS_MODEL=

# Use one provider key. Keep the real value only on the host/secret store.
LLM_API_KEY=
MINIVERSE_LLM_BASE_URL=

# Low-cost verification mode: skips multi-agent preflight and QA, leaving only the builder LLM call.
MINIVERSE_SMOKE_MODE=false

MINIVERSE_MAX_PARALLEL_AGENTS=4
MINIVERSE_WORKER_LEASE_SECONDS=120
MINIVERSE_WORKER_HEARTBEAT_SECONDS=30
MINIVERSE_WORKER_RETRY_BASE_SECONDS=15
MINIVERSE_WORKER_POLL_SECONDS=2
