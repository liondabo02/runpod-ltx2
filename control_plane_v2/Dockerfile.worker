FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

COPY control_plane_v2 /app/control_plane_v2
RUN python -m pip install --upgrade pip \
    && python -m pip install /app/control_plane_v2

RUN useradd --create-home --uid 10001 miniverse \
    && mkdir -p /var/lib/miniverse /workspace \
    && chown -R miniverse:miniverse /var/lib/miniverse /workspace /app

USER miniverse

HEALTHCHECK --interval=30s --timeout=5s --start-period=45s --retries=3 \
    CMD miniverse-health --path /var/lib/miniverse/worker-heartbeat.json --max-age-seconds 90 || exit 1

CMD ["miniverse-worker", "run"]
