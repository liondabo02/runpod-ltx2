{
  "policy": {
    "mode": "FREE-ONLY",
    "default": "deny",
    "live_external_execution": false,
    "paid_execution": false,
    "production_activation": false,
    "credentials_or_browser_cookies": false,
    "rule": "Free software, free API quota and free compute are separate facts. All three must be verified before unattended execution."
